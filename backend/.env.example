MONGO_URI=mongodb://localhost:27017/hr-me
PORT=5000

# Single public origin of the Angular app (email links). No comma, no trailing slash.
# FRONTEND_URL=https://your-domain.com
# PUBLIC_APP_URL=https://your-domain.com

# LLM (OpenAI-compatible). Recommended free tier: https://console.groq.com — create API key
LLM_API_KEY=
# Optional overrides (defaults suit Groq):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional: free TTS used by POST /api/tts/speak — Google TTS (fr) primary,
# Microsoft Edge neural fallback. TTS_VOICE_LANG overrides the spoken language.
# TTS_VOICE_LANG=en-US
# TTS_EDGE_DISABLE=1 disables server TTS (browser voice fallback)

# Troisieme cle Groq — dediee a la generation de CV (workspace Resume Studio)
# Repli sur GROQ_SECOND_API_KEY / LLM_API_KEY si absente.
GROQ_API_KEY=
